# OpenAI 호환 API. 이 파일을 .env 로 복사해서 채운다.
OPENAI_API_KEY=sk-...

# baseUrl 은 자유롭게 바꾼다 — OpenAI, Azure 게이트웨이, vLLM, Ollama, 사내 프록시 등
# 끝에 /v1 까지 포함. /chat/completions 는 서버가 붙인다.
OPENAI_BASE_URL=https://api.openai.com/v1

# 기본 모델
OPENAI_MODEL=gpt-4o

# SVG 재생성 전용 모델 (비우면 OPENAI_MODEL 을 쓴다)
OPENAI_MODEL_SVG=

# 요청 타임아웃 (ms)
OPENAI_TIMEOUT_MS=180000

# 서버 포트
PORT=5174
